{
  "components": {
    "schemas": {
      "BootstrapRequest": {
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "maxLength": 128,
            "title": "Ticket",
            "type": "string"
          }
        },
        "required": [
          "ticket"
        ],
        "title": "BootstrapRequest",
        "type": "object"
      },
      "BootstrapResponse": {
        "properties": {
          "authorized": {
            "title": "Authorized",
            "type": "boolean"
          }
        },
        "required": [
          "authorized"
        ],
        "title": "BootstrapResponse",
        "type": "object"
      },
      "DeliveryWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "queue_unavailable",
            "default": "queue_unavailable",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "const": "Queue is temporarily unavailable.",
            "default": "Queue is temporarily unavailable.",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "DeliveryWarning",
        "type": "object"
      },
      "DiagnosticCreate": {
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey"
        ],
        "title": "DiagnosticCreate",
        "type": "object"
      },
      "DiagnosticError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "deadline_exceeded",
              "attempts_exhausted",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "enum": [
              "Diagnostic deadline exceeded.",
              "Diagnostic attempts exhausted.",
              "Diagnostic could not be completed."
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DiagnosticError",
        "type": "object"
      },
      "DiagnosticExecution": {
        "additionalProperties": false,
        "properties": {
          "attemptCount": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Attemptcount",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "deliveryWarning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeliveryWarning"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "requestId",
          "idempotencyKey",
          "status",
          "attemptCount",
          "createdAt",
          "updatedAt"
        ],
        "title": "DiagnosticExecution",
        "type": "object"
      },
      "DiagnosticResponse": {
        "additionalProperties": false,
        "properties": {
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticExecution"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "execution"
        ],
        "title": "DiagnosticResponse",
        "type": "object"
      },
      "DiagnosticResult": {
        "additionalProperties": false,
        "properties": {
          "fixtureVersion": {
            "const": "m0-v1",
            "default": "m0-v1",
            "title": "Fixtureversion",
            "type": "string"
          },
          "message": {
            "const": "diagnostic_completed",
            "default": "diagnostic_completed",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "DiagnosticResult",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "invalid",
            "default": "invalid",
            "title": "Code",
            "type": "string"
          },
          "path": {
            "enum": [
              "ticket",
              "idempotency_key",
              "idempotencyKey",
              "baseRevisionId",
              "full_name",
              "professional_headline",
              "email",
              "phone_original",
              "objective_original",
              "city_of_residence",
              "country_of_residence",
              "linkedin_url",
              "github_url",
              "company_name_original",
              "job_title_original",
              "start_date_original",
              "end_date_original",
              "start_period",
              "end_period",
              "end_date_is_current_as_of_source",
              "location",
              "text_original",
              "text_current",
              "statement_type",
              "title",
              "title_is_generated_label",
              "description_original",
              "description_current",
              "time_to_develop_original",
              "metric_type",
              "metric_value",
              "metric_unit",
              "metric_meaning",
              "name",
              "original_labels",
              "category",
              "explicitly_listed_in_skills_section",
              "institution",
              "program_original",
              "ongoing_as_of_source_document",
              "currently_ongoing",
              "language",
              "proficiency_original",
              "description",
              "evidence_kind",
              "source_document_id",
              "page"
            ],
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
