{
  "components": {
    "schemas": {
      "BootstrapRequest": {
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "maxLength": 128,
            "title": "Ticket",
            "type": "string"
          }
        },
        "required": [
          "ticket"
        ],
        "title": "BootstrapRequest",
        "type": "object"
      },
      "BootstrapResponse": {
        "properties": {
          "authorized": {
            "title": "Authorized",
            "type": "boolean"
          }
        },
        "required": [
          "authorized"
        ],
        "title": "BootstrapResponse",
        "type": "object"
      },
      "DeliveryWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "queue_unavailable",
            "default": "queue_unavailable",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "const": "Queue is temporarily unavailable.",
            "default": "Queue is temporarily unavailable.",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "DeliveryWarning",
        "type": "object"
      },
      "DiagnosticCreate": {
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey"
        ],
        "title": "DiagnosticCreate",
        "type": "object"
      },
      "DiagnosticError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "deadline_exceeded",
              "attempts_exhausted",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "enum": [
              "Diagnostic deadline exceeded.",
              "Diagnostic attempts exhausted.",
              "Diagnostic could not be completed."
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DiagnosticError",
        "type": "object"
      },
      "DiagnosticExecution": {
        "additionalProperties": false,
        "properties": {
          "attemptCount": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Attemptcount",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "deliveryWarning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeliveryWarning"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticError"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "idempotencyKey": {
            "format": "uuid",
            "title": "Idempotencykey",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "queued",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "id",
          "requestId",
          "idempotencyKey",
          "status",
          "attemptCount",
          "createdAt",
          "updatedAt"
        ],
        "title": "DiagnosticExecution",
        "type": "object"
      },
      "DiagnosticResponse": {
        "additionalProperties": false,
        "properties": {
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiagnosticExecution"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "execution"
        ],
        "title": "DiagnosticResponse",
        "type": "object"
      },
      "DiagnosticResult": {
        "additionalProperties": false,
        "properties": {
          "fixtureVersion": {
            "const": "m0-v1",
            "default": "m0-v1",
            "title": "Fixtureversion",
            "type": "string"
          },
          "message": {
            "const": "diagnostic_completed",
            "default": "diagnostic_completed",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "DiagnosticResult",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HttpError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthorized",
              "forbidden_origin",
              "active_diagnostic",
              "body_too_large",
              "invalid_request",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "HttpError",
        "type": "object"
      },
      "HttpErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/HttpError"
          }
        },
        "required": [
          "error"
        ],
        "title": "HttpErrorResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "LocalSession": {
        "in": "cookie",
        "name": "resume_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Resume Builder M0",
    "version": "0.1.0"
  },
