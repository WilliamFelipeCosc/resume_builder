      "HttpError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "unauthorized",
              "forbidden_origin",
              "forbidden",
              "not_found",
              "active_diagnostic",
              "stale_revision",
              "idempotency_conflict",
              "dependent_changes",
              "missing_candidate_dependency",
              "body_too_large",
              "unsupported_media_type",
              "invalid_request",
              "rate_limited",
              "storage_unavailable",
              "database_busy",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "fieldErrors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fielderrors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "HttpError",
        "type": "object"
      },
      "HttpErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/HttpError"
          }
        },
        "required": [
          "error"
        ],
        "title": "HttpErrorResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "LocalSession": {
        "in": "cookie",
        "name": "resume_session",
        "type": "apiKey"
      }
    }
